# Ignore all files in storage except .gitkeep
/uploads/*
!/uploads/.gitkeep

# AI analysis and working files
/.ai/

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins  
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
.next/
out/

# Production builds
/build
/dist

# Environment variables
.env
.env*.local

# IDE
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python

# Temporary files
*.tmp
*.temp
*.pkl
