# Environment Variables Template
# Copy this to .env.local and fill in your values

# Next.js
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# MongoDB (use localhost when running without Docker)
MONGODB_URI=mongodb://localhost:27017/kreeda_hiring

# Redis (use localhost when running without Docker)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible Storage)
# For Docker: use minio:9000, for local: use localhost:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_RESUMES=resumes
MINIO_BUCKET_DOCUMENTS=documents

# API Keys
OPENAI_API_KEY=

# Application Settings
UPLOAD_DIR=./Uploaded_Resumes
MAX_FILE_SIZE=10485760
