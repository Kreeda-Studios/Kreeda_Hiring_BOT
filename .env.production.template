# Production Environment Variables
# Copy this template to your server and update the values

# ============================================
# REQUIRED: Set your Tailscale public URL here
# ============================================
# Example: https://kreeda-server.tailxxxxx.ts.net
NEXT_PUBLIC_BASE_URL=https://YOUR_TAILSCALE_URL_HERE

# ============================================
# REQUIRED: Set your OpenAI API key
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Optional: Set to production mode
# ============================================
NODE_ENV=production

# All other variables are set in docker-compose.yml
# No need to modify them - they use internal Docker networking
