# ==================================================================
# ProcessingScripts - Local Development Environment
# ==================================================================
# Use this when running ProcessingScripts locally (outside Docker)
# Infrastructure services should be running in Docker
#
# If running in Docker, environment variables are set in docker-compose.yml
# ==================================================================

# Redis Configuration (BullMQ)
REDIS_HOST=hrbot-redis
REDIS_PORT=6379
REDIS_URL=redis://hrbot-redis:6379

# MongoDB Configuration
MONGODB_URI=mongodb://hrbot-mongodb:27017/hrbot_hiring

# S3 Storage Configuration
S3_ENDPOINT=hrbot-s3:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RESUMES=resumes
S3_USE_SSL=false
S3_REGION=us-east-1

# Backend API Configuration
API_BASE_URL=http://hrbot-fullstack:3000

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# ==================================================================
# Queue Concurrency Settings
# ==================================================================
# Set how many jobs each queue can process concurrently
# Lower = safer, higher = faster (if you have resources)

RESUME_QUEUE_CONCURRENCY=1
# Add more queue concurrency settings as needed:
# RANKING_QUEUE_CONCURRENCY=2
# NOTIFICATION_QUEUE_CONCURRENCY=5
